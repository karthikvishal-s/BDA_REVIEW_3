# Large artefacts are regenerated locally by running the pipeline.
data/raw/*
data/processed/*
data/features/*
!data/*/.gitkeep
data/samples/synthetic_smoke.csv

models/*
!models/.gitkeep
# The full-data models are committed (14 MB) so teammates can evaluate / predict without retraining.
!models/full/

outputs/spark-events/*
!outputs/*/.gitkeep

# Build output
scala/target/
scala/project/target/
scala/project/project/
.bsp/
.metals/
.bloop/

__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.idea/
.vscode/
